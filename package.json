{
  "name": "jewbot",
  "version": "0.1.0",
  "description": "Open-source Cursor-like IDE agent: local LLMs (Ollama), terminal, SSH, agentic loop — $0 by default",
  "main": "dist/main/index.js",
  "author": "lonniebeal-droid",
  "license": "MIT",
  "homepage": "https://github.com/lonniebeal-droid/jewbot",
  "desktopName": "jewbot.desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/lonniebeal-droid/jewbot.git"
  },
  "scripts": {
    "build": "tsc && npm run copy:static",
    "copy:static": "node scripts/copy-static.js",
    "start": "npm run build && electron .",
    "rebuild:native": "electron-builder install-app-deps",
    "dist": "npm run build && node scripts/dist.js",
    "dist:linux": "npm run build && node scripts/dist.js --linux AppImage deb",
    "dist:mac": "npm run build && node scripts/dist.js --mac dmg zip",
    "dist:win": "npm run build && node scripts/dist.js --win nsis",
    "dev": "tsc -w",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test:safety": "npx --yes tsx scripts/smoke-safety.ts",
    "test:m1": "npx --yes tsx scripts/smoke-m1.ts",
    "test:m2": "npx --yes tsx scripts/smoke-m2.ts",
    "test:m3": "npx --yes tsx scripts/smoke-m3.ts",
    "test:m4": "npx --yes tsx scripts/smoke-m4.ts",
    "test:m5": "npx --yes tsx scripts/smoke-m5.ts",
    "test:m6": "npx --yes tsx scripts/smoke-m6.ts",
    "test:muse": "npx --yes tsx scripts/smoke-muse.ts",
    "test:m8": "npx --yes tsx scripts/smoke-m8.ts",
    "test:fleet": "npx --yes tsx scripts/smoke-fleet.ts",
    "test:street": "npx --yes tsx scripts/smoke-street-trader.ts",
    "test:portfolio": "npx --yes tsx scripts/smoke-portfolio.ts",
    "test:ui": "npm run build && JEWBOT_UI_SMOKE=1 electron . --no-sandbox --disable-gpu",
    "test": "npm run test:safety && npm run test:m1 && npm run test:m2 && npm run test:m3 && npm run test:m4 && npm run test:m5 && npm run test:m6 && npm run test:muse && npm run test:m8 && npm run test:fleet && npm run test:street && npm run test:portfolio"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "diff": "^7.0.0",
    "ignore": "^6.0.2",
    "ssh2": "^1.16.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/diff": "^6.0.0",
    "@types/node": "^22.13.10",
    "@types/ssh2": "^1.15.4",
    "electron": "^35.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.8.2"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  }
}
