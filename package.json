{
  "name": "jewbot",
  "version": "0.5.0",
  "description": "Open-source Cursor-like IDE agent: local LLMs (Ollama), terminal, SSH, agentic loop — $0 by default",
  "main": "dist/main/index.js",
  "author": "lonniebeal-droid",
  "license": "MIT",
  "homepage": "https://github.com/lonniebeal-droid/jewbot",
  "desktopName": "jewbot.desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/lonniebeal-droid/jewbot.git"
  },
  "scripts": {
    "build": "tsc && npm run copy:static",
    "copy:static": "node scripts/copy-static.js",
    "start": "npm run build && electron .",
    "rebuild:native": "electron-builder install-app-deps",
    "dist": "npm run build && node scripts/dist.js",
    "dist:linux": "npm run build && node scripts/dist.js --linux AppImage deb",
    "dist:mac": "npm run build && node scripts/dist.js --mac dmg zip",
    "dist:win": "npm run build && node scripts/dist.js --win nsis",
    "dev": "tsc -w",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test:safety": "npx --yes tsx scripts/smoke-safety.ts",
    "test:m1": "npx --yes tsx scripts/smoke-m1.ts",
    "test:m2": "npx --yes tsx scripts/smoke-m2.ts",
    "test:m3": "npx --yes tsx scripts/smoke-m3.ts",
    "test:m4": "npx --yes tsx scripts/smoke-m4.ts",
    "test:m5": "npx --yes tsx scripts/smoke-m5.ts",
    "test:m6": "npx --yes tsx scripts/smoke-m6.ts",
    "test:muse": "npx --yes tsx scripts/smoke-muse.ts",
    "test:m8": "npx --yes tsx scripts/smoke-m8.ts",
    "test:fleet": "npx --yes tsx scripts/smoke-fleet.ts",
    "test:street": "npx --yes tsx scripts/smoke-street-trader.ts",
    "test:portfolio": "npx --yes tsx scripts/smoke-portfolio.ts",
    "test:music": "tsx scripts/smoke-music.ts",
    "test:echo": "npx --yes tsx scripts/smoke-echo.ts",
    "test:twinrent": "npx --yes tsx scripts/smoke-twinrent.ts",
    "test:route": "npx --yes tsx scripts/smoke-route.ts",
    "test:m9": "npx --yes tsx scripts/smoke-m9.ts",
    "test:m10": "npx --yes tsx scripts/smoke-m10.ts",
    "test:m11": "npx --yes tsx scripts/smoke-m11.ts",
    "test:m12": "npx --yes tsx scripts/smoke-m12.ts",
    "test:m13": "npx --yes tsx scripts/smoke-m13.ts",
    "test:m14": "npx --yes tsx scripts/smoke-m14.ts",
    "test:v03": "npx --yes tsx scripts/smoke-v03.ts",
    "test:m15": "npx --yes tsx scripts/smoke-m15.ts",
    "test:m16": "npx --yes tsx scripts/smoke-m16.ts",
    "test:m17": "npx --yes tsx scripts/smoke-m17.ts",
    "test:m18": "npx --yes tsx scripts/smoke-m18.ts",
    "test:m19": "npx --yes tsx scripts/smoke-m19.ts",
    "test:m20": "npx --yes tsx scripts/smoke-m20.ts",
    "test:m21": "npx --yes tsx scripts/smoke-m21.ts",
    "test:inbox": "npx --yes tsx scripts/smoke-inbox.ts",
    "test:bounded": "npx --yes tsx scripts/smoke-bounded.ts",
    "test:devices": "npx --yes tsx scripts/smoke-devices.ts",
    "test:ui": "npm run build && JEWBOT_UI_SMOKE=1 electron . --no-sandbox --disable-gpu",
    "test:e2e": "tsx scripts/e2e-ollama.ts",
    "test:launch": "npm run build && JEWBOT_LAUNCH_SMOKE=1 electron . --no-sandbox --disable-gpu",
    "test": "npm run test:safety && npm run test:m1 && npm run test:m2 && npm run test:m3 && npm run test:m4 && npm run test:m5 && npm run test:m6 && npm run test:muse && npm run test:m8 && npm run test:fleet && npm run test:street && npm run test:portfolio && npm run test:music && npm run test:echo && npm run test:twinrent && npm run test:route && npm run test:m9 && npm run test:m10 && npm run test:m11 && npm run test:m12 && npm run test:m13 && npm run test:m14 && npm run test:v03 && npm run test:m15 && npm run test:m16 && npm run test:m17 && npm run test:m18 && npm run test:m19 && npm run test:m20 && npm run test:m21 && npm run test:inbox && npm run test:bounded && npm run test:devices"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "diff": "^7.0.0",
    "ignore": "^6.0.2",
    "monaco-editor": "^0.52.2",
    "ssh2": "^1.16.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/diff": "^6.0.0",
    "@types/node": "^22.13.10",
    "@types/ssh2": "^1.15.4",
    "electron": "^35.0.0",
    "electron-builder": "^26.18.0",
    "tsx": "^4.20.6",
    "typescript": "^5.8.2"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  }
}
