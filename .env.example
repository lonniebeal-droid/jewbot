# Local Ollama (default — $0)
OLLAMA_HOST=http://127.0.0.1:11434
JEWBOT_MODEL=qwen2.5-coder:7b

# Folder the agent may read. Defaults to the process working directory.
# JEWBOT_PROJECT_ROOT=/absolute/path/to/project

# Never set unless owner explicitly approves paid/cloud providers.
# Non-local OLLAMA_HOST values are refused without this flag.
# JEWBOT_ALLOW_PAID=1
